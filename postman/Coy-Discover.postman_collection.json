{
  "info": {
    "name": "Coy Discover API",
    "description": "Local API collection for the standalone Coy Discover assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "profileId", "value": "" }
  ],
  "item": [
    {
      "name": "GET /feed",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/feed", "host": ["{{baseUrl}}"], "path": ["feed"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.profiles?.length) pm.collectionVariables.set('profileId', body.profiles[0]._id);"] } }]
    },
    {
      "name": "POST /swipe (like first profile from feed)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"profileId\": \"{{profileId}}\",\n  \"direction\": \"like\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/swipe", "host": ["{{baseUrl}}"], "path": ["swipe"] }
      }
    },
    {
      "name": "GET /matches",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/matches", "host": ["{{baseUrl}}"], "path": ["matches"] }
      }
    },
    {
      "name": "GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    }
  ]
}
